# =====================================================
# API SUNAT Peru - Configuración
# =====================================================

# =====================================================
# Database
# =====================================================
FAC_DB_DSN=mysql:host=localhost;dbname=facturacion;charset=utf8mb4
FAC_DB_USER=root
FAC_DB_PASS=

# =====================================================
# Encryption (AES-256-CBC)
# =====================================================
FAC_ENCRYPTION_KEY=abc123def456ghi789jkl012mno345pq!
FAC_ENCRYPTION_IV=abc123def456ghij

# =====================================================
# SUNAT
# =====================================================
FAC_SUNAT_ENV=beta

# =====================================================
# JWT Authentication
# =====================================================
# Secreto para firmar tokens (generar con: php -r "echo bin2hex(random_bytes(32));")
FAC_JWT_SECRET=3ed6fcf118619e806fc5cce06f0f2a327f054311adac62f69e16f3befb66210a
# Tiempo de vida del token en segundos (8 horas)
FAC_JWT_TTL=28800

# Consulta interna de DNI/RUC. Nunca se expone al navegador.
FAC_DOCUMENT_LOOKUP_BASE_URL=https://apiperu.codemultiall.net.pe/api/v1
FAC_DOCUMENT_LOOKUP_TOKEN=codemultiall2026_*
