[TEMPLATE]
# =====================================================
# API SUNAT Peru - Configuración
# =====================================================
# Copiar este archivo a .env y llenar los valores
# cp .env.example .env
# =====================================================

# =====================================================
# Database
# =====================================================
FAC_DB_DSN=mysql:host=localhost;dbname=facturacion;charset=utf8mb4
FAC_DB_USER=root
FAC_DB_PASS=

# =====================================================
# Encryption (AES-256-CBC)
# =====================================================
# IMPORTANTE: Cambiar estos valores por aleatorios
# Generar con: php -r "echo bin2hex(random_bytes(16));"
# Key = 32 bytes (64 hex chars), IV = 16 bytes (32 hex chars)
FAC_ENCRYPTION_KEY=cambiar-32-bytes-aleatorios-aqui!!!
FAC_ENCRYPTION_IV=cambiar-16-bytes!

# El entorno SUNAT no es global: se configura por empresa en
# empresas_facturacion.entorno (beta | produccion).

# =====================================================
# JWT Authentication
# =====================================================
# Secreto para firmar los tokens de sesión web (mínimo 32 bytes hex)
# Generar con: php -r "echo bin2hex(random_bytes(32));"
FAC_JWT_SECRET=cambiar-64-hex-aleatorios-aqui!!!!!!!!!!!!!!!!!!!!!!!!!!
# Tiempo de vida del token de sesión en segundos (default: 8 horas)
FAC_JWT_TTL=28800

# =====================================================
# Proveedor de consulta DNI/RUC del facturador interno
# =====================================================
FAC_DOCUMENT_LOOKUP_BASE_URL=https://apiperu.codemultiall.net.pe/api/v1
FAC_DOCUMENT_LOOKUP_TOKEN=colocar-token-del-proveedor
