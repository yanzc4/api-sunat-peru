# =====================================================
# API SUNAT Peru - Configuración
# =====================================================
# Copiar este archivo a .env y llenar los valores
# cp .env.example .env
# =====================================================

# =====================================================
# Database
# =====================================================
FAC_DB_DSN=mysql:host=localhost;dbname=facturacion;charset=utf8mb4
FAC_DB_USER=root
FAC_DB_PASS=

# =====================================================
# Encryption (AES-256-CBC)
# =====================================================
# IMPORTANTE: Cambiar estos valores por aleatorios
# Generar con: php -r "echo bin2hex(random_bytes(16));"
# Key = 32 bytes (64 hex chars), IV = 16 bytes (32 hex chars)
FAC_ENCRYPTION_KEY=cambiar-32-bytes-aleatorios-aqui!!!
FAC_ENCRYPTION_IV=cambiar-16-bytes!

# =====================================================
# SUNAT
# =====================================================
# beta | produccion
FAC_SUNAT_ENV=beta
