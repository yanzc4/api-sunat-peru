{
    "name": "api-sunat-peru/facturacion",
    "description": "Módulo de facturación electrónica SUNAT para PHP",
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.1",
        "flightphp/core": "^3.19",
        "greenter/lite": "^4.0",
        "greenter/report": "^4.0",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "App\\Facturacion\\": "app/Facturacion/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
